#!/bin/bash
#PBS -P vp91
#PBS -q gpuvolta
#PBS -l ncpus=24
#PBS -l ngpus=2
#PBS -l mem=8gb
#PBS -l jobfs=1GB
#PBS -l walltime=00:15:00
#PBS -l storage=scratch/vp91+gdata/vp91
#PBS -l wd
#PBS -N 05-jacobi-overlap
#PBS -j oe


set -eu
module purge
module load cuda/12.9.0 openmpi/4.1.5


mpirun -np 2 --map-by ppr:2:node /scratch/vp91/$USER/intro-to-mpi/build/bin/05-jacobi-overlap 64 64 200
