#!/bin/bash
#PBS -P jxj900
#PBS -q gpuvolta
# Two complete four-GPU Volta nodes are required to guarantee two hosts.
#PBS -l ncpus=96
#PBS -l ngpus=8
#PBS -l mem=64gb
#PBS -l jobfs=1GB
#PBS -l walltime=00:20:00
#PBS -l storage=scratch/jxj900
#PBS -l wd
#PBS -N cuda-mpi-rdma
#PBS -j oe
set -eu
module purge
module load cuda/11.4.1 openmpi/4.1.5
mpirun -np 2 --map-by ppr:1:node build/bin/06-bandwidth
