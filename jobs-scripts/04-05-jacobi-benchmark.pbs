#!/bin/bash
#PBS -P jxj900
#PBS -q gpuvolta
#PBS -l ncpus=24
#PBS -l ngpus=2
#PBS -l mem=8gb
#PBS -l jobfs=1GB
#PBS -l walltime=00:20:00
#PBS -l storage=scratch/jxj900
#PBS -l wd
#PBS -N jacobi-bench
#PBS -j oe


set -eu
module purge
module load cuda/11.4.1 openmpi/4.1.5


for n in 2048 4096 8192; do
  mpirun -np 2 --map-by ppr:2:node build/bin/04-jacobi-blocking "$n" "$n" 200
  mpirun -np 2 --map-by ppr:2:node build/bin/05-jacobi-overlap "$n" "$n" 200
done
