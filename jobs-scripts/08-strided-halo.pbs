#!/bin/bash
#PBS -P jxj900
#PBS -q gpuvolta
#PBS -l ncpus=24
#PBS -l ngpus=2
#PBS -l mem=8gb
#PBS -l jobfs=1GB
#PBS -l walltime=00:10:00
#PBS -l storage=scratch/jxj900
#PBS -l wd
#PBS -N mpi-strided
#PBS -j oe
set -eu
module purge
module load cuda/11.4.1 openmpi/4.1.5
mpirun -np 2 --map-by ppr:2:node build/bin/08-strided-halo packed
# Optional after the packed path passes; support is MPI/transport dependent:
if ! mpirun -np 2 --map-by ppr:2:node build/bin/08-strided-halo datatype; then
  echo "Device derived datatype is unsupported on this MPI/transport; packed path passed."
fi
